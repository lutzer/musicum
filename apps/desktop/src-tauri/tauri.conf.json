{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musicum",
  "version": "0.1.0",
  "identifier": "app.musicum.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Musicum", 
        "width": 1200, 
        "height": 800, 
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "decorations": true }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/plugins/**",
          "$APPDATA/plugins/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["resources/plugins/**/*"]
  }
}
